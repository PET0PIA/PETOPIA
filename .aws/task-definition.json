{
  "family": "petopia-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/petopia-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/petopia-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "petopia",
      "image": "__IMAGE__",
      "essential": true,
      "stopTimeout": 30,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" },
        { "containerPort": 8081, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "release" },
        { "name": "TZ", "value": "Asia/Seoul" },
        { "name": "DB_PORT", "value": "3306" },
        { "name": "DB_DATABASE", "value": "petopia_db" },
        { "name": "DB_USER", "value": "petopia_user" },
        { "name": "REDIS_PORT", "value": "6379" },
        { "name": "S3_BUCKET", "value": "petopia-bucket" },
        { "name": "STORAGE_PUBLIC_BASE_URL", "value": "https://d2jl6zs612zyt4.cloudfront.net" },
        { "name": "AWS_REGION", "value": "ap-northeast-2" },
        { "name": "S3_TMP_PREFIX", "value": "tmp/" },
        { "name": "S3_CONFIRMED_PREFIX", "value": "uploads/" },
        { "name": "S3_PRESIGN_EXPIRY", "value": "5m" },
        { "name": "WAITING_ROOM_ACTIVE_TTL", "value": "12m" },
        { "name": "WAITING_ROOM_TICKET_TTL", "value": "30m" },
        { "name": "WAITING_ROOM_DEFAULT_ACTIVE_LIMIT", "value": "1000" },
        { "name": "TOSS_API_VERSION", "value": "2024-06-01" },
        { "name": "COOKIE_SECURE", "value": "true" },
        { "name": "CORS_ALLOWED_ORIGINS", "value": "https://petopia-kappa.vercel.app" },
        { "name": "FRONTEND_URL", "value": "https://petopia-kappa.vercel.app" },
        { "name": "GOOGLE_REDIRECT_URI", "value": "https://petopia-kappa.vercel.app/api/auth/oauth/google/callback" },
        { "name": "NAVER_REDIRECT_URI", "value": "https://petopia-kappa.vercel.app/api/auth/oauth/naver/callback" }
      ],
      "secrets": [
        { "name": "DB_HOST", "valueFrom": "/petopia/prod/DB_HOST" },
        { "name": "DB_PASSWORD", "valueFrom": "/petopia/prod/DB_PASSWORD" },
        { "name": "REDIS_HOST", "valueFrom": "/petopia/prod/REDIS_HOST" },
        { "name": "REDIS_PASSWORD", "valueFrom": "/petopia/prod/REDIS_PASSWORD" },
        { "name": "ENTRY_QR_SECRET", "valueFrom": "/petopia/prod/ENTRY_QR_SECRET" },
        { "name": "JWT_SECRET", "valueFrom": "/petopia/prod/JWT_SECRET" },
        { "name": "GMAIL_USERNAME", "valueFrom": "/petopia/prod/GMAIL_USERNAME" },
        { "name": "GMAIL_APP_PASSWORD", "valueFrom": "/petopia/prod/GMAIL_APP_PASSWORD" },
        { "name": "NTS_SERVICE_KEY", "valueFrom": "/petopia/prod/NTS_SERVICE_KEY" },
        { "name": "TOSS_CLIENT_KEY", "valueFrom": "/petopia/prod/TOSS_CLIENT_KEY" },
        { "name": "TOSS_SECRET_KEY", "valueFrom": "/petopia/prod/TOSS_SECRET_KEY" },
        { "name": "TOSS_SECURITY_KEY", "valueFrom": "/petopia/prod/TOSS_SECURITY_KEY" },
        { "name": "GOOGLE_CLIENT_ID", "valueFrom": "/petopia/prod/GOOGLE_CLIENT_ID" },
        { "name": "GOOGLE_CLIENT_SECRET", "valueFrom": "/petopia/prod/GOOGLE_CLIENT_SECRET" },
        { "name": "NAVER_CLIENT_ID", "valueFrom": "/petopia/prod/NAVER_CLIENT_ID" },
        { "name": "NAVER_CLIENT_SECRET", "valueFrom": "/petopia/prod/NAVER_CLIENT_SECRET" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/petopia",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "petopia"
        }
      }
    }
  ]
}
