<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ms.petopia.api.business.mapper.BusinessMapper">
    
    <resultMap id="businessResultMap" type="com.ms.petopia.api.business.domain.Business">
        <id property="businessId" column="business_id" />
        <result property="ownerId" column="owner_id" />
        <result property="name" column="name" />
        <result property="ceoName" column="ceo_name" />
        <result property="bizRegNo" column="biz_reg_no" />
        <result property="startDate" column="start_date" />
        <result property="address" column="address" />
        <result property="phone" column="phone" />
        <result property="website" column="website" />
        <result property="verifyStatus" column="verify_status" />
        <result property="createdAt" column="created_at" />
    </resultMap>

    <!-- 사업자 등록  및 진위 확인-->
    <insert id="insertBusiness" parameterType="com.ms.petopia.api.business.domain.Business"
            useGeneratedKeys="true" keyProperty="businessId">
        INSERT INTO business (owner_id, name, ceo_name, biz_reg_no, start_date, address, phone, website, verify_status)
        VALUES (#{ownerId}, #{name}, #{ceoName}, #{bizRegNo}, #{startDate}, #{address}, #{phone}, #{website}, #{verifyStatus})
    </insert>

    <!-- 내 사업자 목록 조회 -->
    <select id="selectByOwnerId" parameterType="long" resultMap="businessResultMap">
        SELECT business_id, owner_id, name, ceo_name, biz_reg_no, start_date,
            address, phone, website, verify_status, created_at
        FROM business
        WHERE owner_id = #{ownerId}
        ORDER BY created_at DESC
    </select>

    <!-- 사업자 상세 조회. INSERT 직후 완전한 데이터 재조회할 때도 재사용됨 -->
    <select id="selectById" parameterType="long" resultMap="businessResultMap">
        SELECT business_id, owner_id, name, ceo_name, biz_reg_no, start_date,
            address, phone, website, verify_status, created_at
        FROM business
        WHERE business_id = #{businessId}
    </select>

    <!-- 진위 확인 후 status 변경 -->
    <update id="updateVerifyStatus">
        UPDATE business SET verify_status = #{verifyStatus}
        WHERE business_id = #{businessId}
    </update>

    <!-- ownerId별 동시 등록 직렬화용 애플리케이션 레벨 락. 테이블/행과 무관, users 테이블에 전혀 영향 없음 -->
    <select id="acquireRegistrationLock" resultType="int">
        SELECT GET_LOCK(CONCAT('business_register_', #{ownerId}), 5)
    </select>

    <!-- 락 해제 -->
    <select id="releaseRegistrationLock" resultType="int">
        SELECT RELEASE_LOCK(CONCAT('business_register_', #{ownerId}))
    </select>
    
</mapper>