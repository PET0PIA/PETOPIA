<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ms.petopia.api.application.mapper.ApplicationExpirationMapper">

    <!--
        결제 기한이 지난 PAYMENT_PENDING 신청서를 잠가서 조회.
        FOR UPDATE로 이 배치가 처리 중인 행을 다른 트랜잭션이 못 건드리게 막고,
        SKIP LOCKED로 이미 다른 스케줄러 인스턴스(다중 서버 배포 시)가 잠근 행은 건너뛴다
        - 여러 인스턴스가 동시에 같은 신청서를 중복 처리하는 걸 방지.
    -->
    <select id="selectDueApplicationsForUpdate" resultType="long">
        SELECT application_id
        FROM application
        WHERE status = 'PAYMENT_PENDING'
        AND payment_due_at IS NOT NULL
        AND payment_due_at &lt;= #{now}
        ORDER BY payment_due_at, application_id
        LIMIT #{limit}
        FOR UPDATE SKIP LOCKED
    </select>

    <!--
        자동 취소 처리. WHERE 절에 status='PAYMENT_PENDING' AND payment_due_at <= #{now}를
        다시 한 번 거는 이유: 위 SELECT와 이 UPDATE 사이에 상태가 바뀌었을 수도 있으니
        (예: 그 사이 사용자가 결제를 완료해서 CONFIRMED로 바뀐 경우) 조건에 안 맞으면
        0행 반영되게 해서 실수로 잘못된 신청서를 취소하지 않도록 방지한다.
    -->
    <update id="expirePaymentPendingApplication">
        UPDATE application
        SET status = 'CANCELED'
        WHERE application_id = #{applicationId}
        AND status = 'PAYMENT_PENDING'
        AND payment_due_at IS NOT NULL
        AND payment_due_at &lt;= #{now}
    </update>

</mapper>