<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ms.petopia.api.reservation.mapper.EntryStatsMapper">

    <!--
      홈 화면용 전체 입장 집계. 숫자 두 개를 각각 서브쿼리로 뽑아 한 번에 가져온다
      (두 번 왕복하지 않기 위해서다. 두 집계는 서로 조건이 달라 한 쿼리로 합칠 수 없다).

      visitorCount: entry_records는 실제로 게이트를 통과했을 때만 쌓이므로, 이 테이블이
        곧 "방문했다"의 근거다(예약만 하고 안 온 사람은 없다). user_id로 중복을 제거해
        같은 사람이 여러 행사에 다녀와도 1명으로 센다.

      petCount: 입장 기록에 딸린 예약의 동반 반려동물만 센다 - 등록만 해두고 행사에
        데려오지 않은 반려동물은 빠진다("함께한 반려동물"이라는 표현에 맞춘 정의).
        통계 도메인의 방문 통계(ReservationDashboardMapper.selectPetSpeciesBreakdown)는
        entry_records -> reservations -> reservation_pets로 세 단계를 거치는데, 여기서는
        reservations를 건너뛴다 - reservation_pets가 reservation_id를 직접 들고 있어서
        같은 결과가 나오고, 조인 한 단계를 줄일 수 있다.
    -->
    <select id="selectPublicEntryStats" resultType="PublicEntryStatsRow">
        SELECT (
                   SELECT COUNT(DISTINCT enr.user_id)
                     FROM entry_records enr
               ) AS visitor_count
             , (
                   SELECT COUNT(DISTINCT rp.pet_id)
                     FROM entry_records enr
                     JOIN reservation_pets rp
                       ON rp.reservation_id = enr.reservation_id
               ) AS pet_count
    </select>
</mapper>
