# .env.example — 이 파일을 .env 로 복사한 뒤 실제 값을 채운다.
#   cp .env.example .env
# .env 는 커밋되지 않는다. (.gitignore)
#
# docker-compose.release.yaml 과 application-release.yaml 이 함께 참조한다.
# 둘 중 한쪽만 바꾸면 컨테이너와 앱이 서로 다른 값을 바라보게 되니 주의.

# ===== MySQL 설정 =====
DB_PORT=3306
DB_ROOT_PASSWORD=
DB_DATABASE=petopia_db
DB_USER=petopia_user
DB_PASSWORD=

# ===== Redis 설정 =====
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 애플리케이션 전용 =====
# compose가 포트를 호스트에 공개하고 앱은 같은 서버에서 실행되므로 기본값은 localhost.
# 값을 지정하지 않으면 application-release.yaml 의 기본값(localhost)이 쓰인다.
# 앱까지 컨테이너로 올리면 각각 mysql / redis 로 바꾼다.
#DB_HOST=localhost
#REDIS_HOST=localhost
