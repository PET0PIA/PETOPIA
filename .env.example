# .env.example — 이 파일을 .env 로 복사한 뒤 실제 값을 채운다.
#   cp .env.example .env
# .env 는 커밋되지 않는다. (.gitignore)
#
# 이 저장소는 공개(public)다. 실제 값을 이 파일에 적지 않는다.
#
# ---------------------------------------------------------------------------
# 운영은 t3.micro 2대로 나뉜다. 두 인스턴스의 .env 내용이 서로 다르다.
#
#   인스턴스 A (앱)        docker-compose.app.yaml
#     APP_IMAGE / DB_HOST / REDIS_HOST / DB_PORT / DB_DATABASE / DB_USER
#     DB_PASSWORD / REDIS_PORT / REDIS_PASSWORD / ENTRY_QR_SECRET / JWT_SECRET
#
#   인스턴스 B (MySQL+Redis)  docker-compose.release.yaml
#     DB_PORT / DB_ROOT_PASSWORD / DB_DATABASE / DB_USER / DB_PASSWORD
#     REDIS_PORT / REDIS_PASSWORD
#
# 배포 시에는 SSM Send-Command 스크립트가 SSM Parameter Store 에서 값을 받아
# 각 인스턴스의 .env 를 생성한다. 손으로 만드는 것은 최초 구성 때뿐이다.
#
# 양쪽에 공통으로 들어가는 값은 반드시 같아야 한다. 한쪽만 바꾸면 연결이 끊긴다.
#   DB_PORT / DB_DATABASE / DB_USER / DB_PASSWORD / REDIS_PORT / REDIS_PASSWORD
# 포트도 공유 값이다. B 가 그 포트로 게시하고 A 가 그 포트로 접속하기 때문에,
# B 에서만 비기본값으로 바꾸면 A 는 application-release.yaml 의 기본값
# (3306 / 6379)으로 접속하다 실패한다.
# ---------------------------------------------------------------------------

# ===== 접속 대상 (인스턴스 A 에만 필요) =====
# 인스턴스 B 의 사설 IP. 반드시 채운다.
# 비워 두면 application-release.yaml 의 기본값 localhost 가 쓰여
# 앱이 자기 자신에게 접속을 시도하다 실패한다.
# 사설 IP 는 인스턴스를 종료(terminate)하지 않는 한 재부팅해도 유지된다.
DB_HOST=
REDIS_HOST=

# 배포할 ECR 이미지. 커밋 SHA 로 태그한다.
# 예: 123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/petopia:a0c843f
APP_IMAGE=

# ===== MySQL 설정 =====
DB_PORT=3306
# 컨테이너 초기화에만 쓰인다. 앱은 이 값을 사용하지 않는다. (인스턴스 B 전용)
DB_ROOT_PASSWORD=
DB_DATABASE=petopia_db
DB_USER=petopia_user
DB_PASSWORD=

# ===== Redis 설정 =====
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 애플리케이션 전용 =====
# 입장 QR 토큰 서명 키. (인스턴스 A 에만 필요)
#
# 생성:  openssl rand -hex 32
#
# 제약 두 가지를 반드시 지킨다.
#
# 1) 32자 이상이어야 한다.
#    EntryQrTokenService 생성자가 미달 시 예외를 던져 앱이 기동하지 못한다.
#    기본값이 없으므로 값을 비워도 마찬가지로 기동 실패다.
#
# 2) 한 번 정하면 절대 바꾸지 않는다.
#    QR 토큰은 nonce 도 만료도 없는 결정적 HMAC 이고, 그 해시가
#    entry_qrs.token_hash 에 UNIQUE 로 저장된다. 키를 바꾸면 이미 발급된
#    QR 이 전부 무효가 되는데, 재발급 로직이 "이미 행이 있으면 건너뛴다"라
#    자동 복구도 되지 않는다. 복구 수단이 수동 DB 수정뿐이다.
#    운영 값은 SSM Parameter Store 에 SecureString 으로 두고 별도 백업한다.
ENTRY_QR_SECRET=

# JWT 서명 키. (인스턴스 A 에만 필요)
#
# 생성:  openssl rand -base64 32
#
# 기본값이 없으므로 값을 비워두면 기동 실패한다. 로컬 개발용 값과
# 절대 같은 값을 쓰지 않는다 (로컬 기본값은 저장소 히스토리에 남아있어 이미
# 유출된 것으로 취급한다).
JWT_SECRET=

# ===== 토스페이먼츠 (인스턴스 A 전용) =====
# 개발자센터(https://developers.tosspayments.com) 에서 발급.
# 로컬/테스트는 test_ck_.../test_sk_... 로 시작하는 테스트 키를 쓴다.
# 운영 전환 시 실제 상점의 라이브 키(live_ck_.../live_sk_...)로 교체.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 웹훅 서명 검증용 보안 키.
TOSS_SECURITY_KEY=
TOSS_API_VERSION=2024-06-01